NODEREF_RE = re.compile(r"^(src|dat|pat|int):")
LOCAL_RE = re.compile(r"^(~/|workspace/|Users/|/Volumes/|memory/|media_library|EPUB|corpus-extract/)")
PROSE_EXT = (".md", ".txt", ".csv", ".json", ".jsonl", ".html", ".htm", ".pdf", ".xlsx")


def unquote(s):
    s = s.strip()
    if len(s) >= 2 and s[0] in "\"'" and s[-1] == s[0]:
        return s[1:-1]
    return s


def iter_sources_pages(root):
    """Yield (relpath, full_text, fm_text, items) for wiki pages with sources:."""
    wiki_dir = os.path.join(root, "wiki")
    for dirpath, _dirs, files in os.walk(wiki_dir):
        for f in files:
            if not f.endswith(".md"):
                continue
            p = os.path.join(dirpath, f)
            try:
                text = open(p, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            m = re.match(r"\A---[ \t]*\n(.*?)\n---[ \t]*\n?", text, re.S)
            if not m:
                continue
            fm = m.group(1)
            items = []
            lines = fm.split("\n")
            for i, line in enumerate(lines):
                sm = re.match(r"^sources:\s*(.*)$", line)
                if not sm:
                    continue
                rest = sm.group(1)
                if rest.startswith("["):
                    buf = rest
                    if "]" not in buf:
                        # multi-line flow list: consume lines until the
                        # closing ]. Single-line flows already contain it;
                        # never glue the following frontmatter line
                        # (e.g. sources_absent:) into sources:.
                        for l2 in lines[i + 1:]:
                            buf += " " + l2.strip()
                            if "]" in l2:
                                break
                    inner = buf[buf.index("[") + 1:buf.rindex("]")]
                    items = [unquote(x) for x in inner.split(",") if x.strip()]
                elif rest == "":
                    for l2 in lines[i + 1:]:
                        lm = re.match(r"^\s*-\s+(.*)$", l2)
                        if lm:
                            items.append(unquote(lm.group(1)))
                        elif re.match(r"^\S", l2):
                            break
                elif rest:
                    items = [unquote(rest)]
            if items:
                yield os.path.relpath(p, root), text, items


def build_pathset(root):
    ps = set()
    for dp, dn, fs in os.walk(root):
        if "/.git/" in dp or dp.endswith("/.git"):
            dn[:] = []
            continue
        dn[:] = [d for d in dn if d not in (".git", "site")]
        rel = os.path.relpath(dp, root)
        for f in fs:
            ps.add(f if rel == "." else rel + "/" + f)
    return ps


def noderef_resolve(entry, pathset):
    core = NODEREF_RE.sub("", entry)
    core = re.sub(r"\s*\(.*?\)\s*$", "", core).strip()
    for cand in ("kb/sources/" + core + ".md", "kb/data/" + core + ".md"):
        if cand in pathset:
            return cand
    return None


def cmd_check(root):
    """Regression gate: every audit-baseline P/N entry and every D2 remap
    target must still resolve in the current tree. B/C/D/E entries are
    labeled, not resolved -- not this gate's business."""
    pathset = build_pathset(root)
    failures = []
    for e in BASELINE_P:
        if e not in pathset:
            failures.append(("P", e, e))
    for e, target in BASELINE_N:
        if target not in pathset:
            failures.append(("N", e, target))
    for old, new, rule in SRC_REMAP:
        if new not in pathset:
            failures.append(("A-target", old, new))
    print(f"wb-sources-repair --check: baseline P={len(BASELINE_P)} "
          f"N={len(BASELINE_N)} remap-targets={len(SRC_REMAP)}")
    if failures:
        print(f"FAIL: {len(failures)} baseline entries no longer resolve:")
        for cls, e, t in failures[:20]:
            print(f"  [{cls}] {e} -> {t}")
        return 1
    print("OK: every baseline P/N entry and every D2 remap target resolves")
    return 0


def _swap_spelling(seg, old, new):
    """Replace one sources: entry spelling inside a raw text segment.
    Returns (new_seg, count). Tries quoted spellings first, then bare."""
    for spelling in ('"%s"' % old, "'%s'" % old):
        if spelling in seg:
            q = spelling[0]
            cnt = seg.count(spelling)
            return seg.replace(spelling, q + new + q), cnt
    pat = r"(?<![\w/.:-])" + re.escape(old) + r"(?![\w/.:-])"
    found = re.findall(pat, seg)
    if found:
        return re.sub(pat, new, seg), len(found)
    return seg, 0


def apply_to_text(text, old, new):
    """Line-surgical replacement of one sources: entry. Returns (text, n)."""
    m = re.match(r"\A(---[ \t]*\n.*?\n---[ \t]*\n?)", text, re.S)
    if not m:
        return text, 0
    head, tail = m.group(1), text[m.end(1):]
    lines = head.split("\n")
    n = 0
    out = []
    i = 0
    while i < len(lines):
        line = lines[i]
        sm = re.match(r"^(sources:\s*)(.*)$", line)
        if sm and i > 0:
            # only treat as the sources field when indented inside frontmatter
            # (i > 0 guards the degenerate single-line head)
            prefix, rest = sm.group(1), sm.group(2)
            if rest.startswith("["):
                # flow list, possibly multi-line: raw segment until ]
                buf_lines = [line]
                j = i + 1
                while j < len(lines) and "]" not in buf_lines[-1]:
                    buf_lines.append(lines[j])
                    j += 1
                seg = "\n".join(buf_lines)
                new_seg, cnt = _swap_spelling(seg, old, new)
                out.append(new_seg)
                n += cnt
                i = j
                continue
            if rest == "":
                out.append(line)
                i += 1
                while i < len(lines):
                    l2 = lines[i]
                    lm = re.match(r"^(\s*-\s+)(.*)$", l2)
                    if lm:
                        dash, val = lm.group(1), lm.group(2).strip()
                        if unquote(val) == old:
                            q = '"' if val.startswith('"') else ("'" if val.startswith("'") else "")
                            out.append(dash + q + new + q)
                            n += 1
                        else:
                            out.append(l2)
                        i += 1
                    elif re.match(r"^\S", l2):
                        break
                    else:
                        out.append(l2)
                        i += 1
                continue
            # scalar form: sources: <entry>
            if unquote(rest) == old:
                q = '"' if rest.startswith('"') else ("'" if rest.startswith("'") else "")
                out.append(prefix + q + new + q)
                n += 1
            else:
                out.append(line)
            i += 1
            continue
        out.append(line)
        i += 1
    return "\n".join(out) + tail, n


def cmd_apply_a(root, write):
    pathset = build_pathset(root)
    # fail-stop: every target must resolve in the CURRENT tree
    missing = [(o, t) for o, t, _r in SRC_REMAP for t in [t] if t not in pathset]
    if missing:
        print("REFUSING: remap targets missing from current tree (not improvising):")
        for o, t in missing:
            print(f"  {o} -> {t}")
        return 2
    changes = []  # (rel, old, new, rule)
    planned = {}  # rel -> new text
    for rel, text, items in iter_sources_pages(root):
        new_text = text
        file_changed = False
        for old, new, rule in SRC_REMAP:
            if old not in items:
                continue
            # duplicate guard: new entry already on the page
            if new in items:
                print(f"SKIP (already present): {rel}: {new}")
                continue
            new_text, cnt = apply_to_text(new_text, old, new)
            if cnt:
                changes.append((rel, old, new, rule))
                file_changed = True
        if file_changed:
            planned[rel] = new_text
    # dry-run diff
    for rel, old, new, rule in changes:
        print(f"[{rule}] {rel}\n  - {old}\n  + {new}")
    print(f"\n{len(changes)} replacements across {len(planned)} pages"
          f" ({len({r for _, _, _, r in changes})} rules)" if changes else "\nno changes")
    if not write:
        print("dry-run: no files written (pass --yes to write)")
        return 0
    for rel, new_text in planned.items():
        with open(os.path.join(root, rel), "w", encoding="utf-8") as f:
            f.write(new_text)
    print(f"wrote {len(planned)} pages")
    # machine-readable change log for the ledger step
    with open(os.path.join(root, "sources-repair-changes.jsonl"), "w", encoding="utf-8") as f:
        for rel, old, new, rule in changes:
            f.write(json_dumps({"page": rel, "old": old, "new": new, "rule": rule}) + "\n")
    print("wrote sources-repair-changes.jsonl (repo root; delete before push)")
    return 0


def json_dumps(o):
    import json as _j
    return _j.dumps(o, ensure_ascii=False)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--repo-root", default=None)
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--apply-a", action="store_true")
    ap.add_argument("--apply-queue", action="store_true")
    ap.add_argument("--yes", action="store_true")
    args = ap.parse_args()
    root = os.path.abspath(args.repo_root or os.path.join(os.path.dirname(__file__), ".."))
    if args.apply_queue:
        print("wb-sources-repair: --apply-queue is not implemented: D3 is on hold "
              "for human review (2026-09-24 decisions). Refusing.")
        return 3
    if args.check:
        return cmd_check(root)
    if args.apply_a:
        return cmd_apply_a(root, write=args.yes)
    ap.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
