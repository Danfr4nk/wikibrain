    ])

    SRC_NODEREF_RE = re.compile(r"^(src|dat|pat|int):")
    SRC_LOCAL_RE = re.compile(r"^(~/|workspace/|Users/|/Volumes/|memory/|media_library|EPUB|corpus-extract/)")
    SRC_PROSE_EXT = (".md", ".txt", ".csv", ".json", ".jsonl", ".html", ".htm", ".pdf", ".xlsx")

    # Full-tree path set: exact-path (P) and directory-prefix (D)
    # resolution need raw/ and testimony/ too, not just wiki/ + kb/.
    # site/ is derived build output - excluded so derived files can
    # never resolve a sources: entry.
    tree_paths = set()
    for _dp, _dn, _fs in os.walk(root):
        if "/.git/" in _dp or _dp.endswith("/.git"):
            _dn[:] = []
            continue
        _dn[:] = [d for d in _dn if d not in (".git", "site")]
        _rel = os.path.relpath(_dp, root)
        for _f in _fs:
            tree_paths.add(_f if _rel == "." else _rel + "/" + _f)

    def _src_norm(entry):
        e = entry.strip()
        e = re.sub(r"^(\./|/)", "", e)
        return e

    def _src_kind(e):
        base = e.rsplit("/", 1)[-1]
        if e.endswith("/") or e.endswith("*") or base == "":
            return "dir"
        if e.startswith("http"):
            return "url"
        if SRC_NODEREF_RE.match(e):
            return "noderef"
        if SRC_LOCAL_RE.match(e):
            return "local"
        return "path"

    _kb_basenames = {}
    for _p in tree_paths:
        if _p.startswith("kb/"):
            _kb_basenames.setdefault(_p.rsplit("/", 1)[-1], _p)

    def _noderef_resolve(e):
        # Audit-faithful candidate list (src_final.py): core = id minus the
        # src:/dat:/pat:/int: prefix, trailing parenthetical stripped; try
        # "<core>.md", bare "<core>", then the doubled-prefix artifacts
        # ("dat:<core>.md", "src:<core>.md") left by the old wb-new id bug.
        # Matched by basename across kb/, exactly as the audit did.
        core = SRC_NODEREF_RE.sub("", e)
        core = re.sub(r"\s*\(.*?\)\s*$", "", core).strip()
        for cand in (core + ".md", core, "dat:" + core + ".md",
                     "src:" + core + ".md", core.lstrip(":") + ".md"):
            if cand in _kb_basenames:
                return _kb_basenames[cand]
        return None

    def _dir_alive(e):
        p = e.rstrip("*").rstrip("/")
        return any(x == p or x.startswith(p + "/") for x in tree_paths)

    SRC_REMAP_LOOKUP = {old: new for old, new, _r in SRC_REMAP}

    def _classify_source(raw_entry):
        e = _src_norm(raw_entry)
        kind = _src_kind(e)
        if kind == "dir":
            alive = _dir_alive(e)
            return ("D", e.rstrip("*").rstrip("/") if alive else None, alive)
        if kind in ("url", "local"):
            return ("E", None, False)
        if kind == "noderef":
            t = _noderef_resolve(e)
            return (("N", t, True) if t else ("C", None, False))
        if e in tree_paths:
            return ("P", e, True)
        if e in SRC_REMAP_LOOKUP and SRC_REMAP_LOOKUP[e] in tree_paths:
            return ("A", SRC_REMAP_LOOKUP[e], True)
        if " " in e and not e.lower().endswith(SRC_PROSE_EXT):
            return ("E", None, False)
        if e in SRC_AMBIGUOUS:
            return ("B", None, False)
        return ("C", None, False)

    def _src_item_str(it):
        # The wiki's node-ref convention writes bare `src:foo` list items.
        # The YAML-faithful frontmatter parser reads those as single-pair
        # mappings {"src": "foo"}; reconstruct the intended reference string.
        if isinstance(it, str):
            return it.strip() or None
        if isinstance(it, dict) and len(it) == 1:
            (k, v), = it.items()
            k = str(k).strip().strip('"').strip("'")
            if k in ("src", "dat", "pat", "int") and isinstance(v, str):
                return "%s:%s" % (k, v.strip().strip('"').strip("'"))
        return None

    sources_pages = {}
    _uniq = {}  # entry -> (class, resolved)
    for pid, pg in pages.items():
        _raw = pg["fm"].get("sources")
        if _raw is None:
            continue
        _items = _raw if isinstance(_raw, list) else [_raw]
        _ents = []
        for _it in _items:
            _s = _src_item_str(_it)
            if not _s:
                continue
            _cls, _tgt, _ok = _classify_source(_s)
            _ents.append({"entry": _s, "class": _cls,
                            "target": _tgt, "resolved": _ok})
            if _s not in _uniq:
                _uniq[_s] = (_cls, _ok)
        if _ents:
            sources_pages[pid] = {
                "entries": _ents,
                "resolved": sum(1 for x in _ents if x["resolved"]),
                "total": len(_ents),
            }

    _cls_counts = {}
    _ures = 0
    for _e, (_c, _ok) in _uniq.items():
        _cls_counts[_c] = _cls_counts.get(_c, 0) + 1
        if _ok:
            _ures += 1
    _eres = sum(x["resolved"] for _p in sources_pages.values()
                for x in _p["entries"])
    _etot = sum(_p["total"] for _p in sources_pages.values())
    sources_coverage = {
        "unique_total": len(_uniq),
        "unique_resolved": _ures,
        "unique_pct": round(100.0 * _ures / len(_uniq), 1) if _uniq else 0.0,
        "entry_total": _etot,
        "entry_resolved": _eres,
        "entry_pct": round(100.0 * _eres / _etot, 1) if _etot else 0.0,
        "classes_unique": _cls_counts,
        "pages_with_sources": len(sources_pages),
    }
    # ---- 3. graph ----
    nodes = {}
    edges = []
    edge_idx = {}  # (source, target, class, relation) -> idx
    evidence_index = {}
    dead_links_total = 0
    unresolvable_conns = 0

    def add_edge(source, target, relation, relation_original, klass, provenance):
        key = (source, target, klass, relation)
        if key in edge_idx:
            edges[edge_idx[key]]["frequency"] += 1
            return
        edge_idx[key] = len(edges)
        edges.append({
            "source": source, "target": target,
            "relation": relation, "relation_original": relation_original,
            "class": klass, "direction": "out",
            "provenance": provenance, "strength": 0.0, "frequency": 1,
        })

    for pid, pg in pages.items():
        fm, body = pg["fm"], strip_fences(pg["body"])
        # wikilinks → ASSOCIATIVE
        for m in WIKILINK_RE.finditer(body):
            tgt = resolve_wikilink(m.group(1), page_ids)
            if tgt is None or tgt == pid:
                if tgt is None:
                    dead_links_total += 1
                    pg.setdefault("dead_link_count", 0)
                    pg["dead_link_count"] += 1
                continue
            add_edge(pid, tgt, "wikilink", None, "ASSOCIATIVE", "body:wikilink")
        # related: / synthesizes: → SEMANTIC
        for field, rel in (("related", "related-to"), ("synthesizes", "synthesizes")):
            for item in (fm.get(field) or []):
                t = item if isinstance(item, str) else item.get("page") or item.get("target")
                if not t:
                    continue
                t = t.strip().strip("[]")
                if t in page_ids and t != pid:
                    add_edge(pid, t, rel, rel, "SEMANTIC", f"frontmatter:{field}")
                else:
                    unresolvable_conns += 1
        # connections: → SEMANTIC (typed)
        conns = fm.get("connections") or []
        if isinstance(conns, dict):
            conns = []
        for c in conns:
            if not isinstance(c, dict):
                continue
            t = (c.get("page") or c.get("target") or "").strip().strip("[]")
            rel_raw = (c.get("type") or c.get("relation") or "related-to")
            if t in page_ids and t != pid:
                add_edge(pid, t, family_of(rel_raw), rel_raw, "SEMANTIC",
                         "frontmatter:connections")
            else:
                unresolvable_conns += 1
        # kb cites → EVIDENCE
        ev_items = []
        for m in CITE_RE.finditer(body):
            cid = clean_cite_id(m.group(1), m.group(2))
            resolved_id, ok, how = resolve_cite(cid)
            line = body[:m.start()].count("\n") + 1
            if ok:
                node = kb_nodes[resolved_id]
                add_edge(pid, resolved_id, "cites", None, "EVIDENCE", "body:cite")
                ev_items.append({
                    "cite": cid, "resolved": True,
                    "resolved_id": resolved_id,
                    "node_type": node["node_type"], "node_title": node["title"],
                    "claim": node["claim"], "confidence": node["confidence"],
                    "created": node["created"], "tags": node["tags"],
                    "source_location": f"{pid}#L{line}",
                    "resolution": how or "exact",
                })
            else:
                ev_items.append({
                    "cite": cid, "resolved": False,
                    "source_location": f"{pid}#L{line}",
                    "resolution": how,
                })
        if ev_items:
            evidence_index[pid] = ev_items

    # ---- 4. timeline ----
    tl_path = os.path.join(wiki_dir, "timeline", "master-timeline.md")
    events = parse_timeline(tl_path)
    chrono_pages = {e["page"] for e in events if e["page"]}

    # ---- 5. nodes ----
    out_deg = {}
    in_deg = {}
    for e in edges:
        out_deg[e["source"]] = out_deg.get(e["source"], 0) + 1
        in_deg[e["target"]] = in_deg.get(e["target"], 0) + 1

    BASE_STRENGTH = {"SEMANTIC": 0.9, "EVIDENCE": 0.8, "ASSOCIATIVE": 0.6}
    hub_ids = set()
    for pid, pg in pages.items():
        hr = hub_reason_for(pid)
        if hr:
            hub_ids.add(pid)
    for e in edges:
        s = BASE_STRENGTH[e["class"]]
        if e["target"] in hub_ids:
            s *= 0.3
        if e["frequency"] > 3:
            s *= 0.7
        e["strength"] = round(s, 3)

    # adjacency
    adj_out, adj_in = {}, {}
    for idx, e in enumerate(edges):
        adj_out.setdefault(e["source"], []).append(idx)
        adj_in.setdefault(e["target"], []).append(idx)

    for pid, pg in pages.items():
        fm = pg["fm"]
        hr = hub_reason_for(pid)
        title = fm.get("title") or pid.split("/")[-1].replace("-", " ")
        nodes[pid] = {
            "id": pid,
            "title": title if isinstance(title, str) else str(title),
            "domain": fm.get("domain"),
            "page_type": fm.get("page_type"),
            "tags": fm.get("tags") or [],
            "aliases": fm.get("aliases") or [],
            "date_start": fm.get("date_range_start"),
            "date_end": fm.get("date_range_end"),
            "hub": hr is not None,
            "hub_reason": hr,
            "out_degree": out_deg.get(pid, 0),
            "in_degree": in_deg.get(pid, 0),
            "evidence_count": len([x for x in evidence_index.get(pid, []) if x["resolved"]]),
            "has_chronology": pid in chrono_pages or bool(fm.get("date_range_start")),
            "dead_link_count": pg.get("dead_link_count", 0),
            "outbound": adj_out.get(pid, []),
            "inbound": adj_in.get(pid, []),
        }

    # ---- 6. search adapter ----
    search = []
    for pid, pg in pages.items():
        n = nodes[pid]
        sample = re.sub(r"\s+", " ", re.sub(r"[#*`>\[\]()]", "", pg["body"][:400]))[:200]
        search.append({
            "id": pid, "title": n["title"], "aliases": n["aliases"],
            "domain": n["domain"], "page_type": n["page_type"],
            "tags": n["tags"], "rel_count": n["out_degree"] + n["in_degree"],
            "evidence": n["evidence_count"] > 0, "chrono": n["has_chronology"],
            "sample": sample,
        })
    search.sort(key=lambda s: -s["rel_count"])

    # ---- 7. write ----
    data_dir = os.path.join(out, "data")
    os.makedirs(data_dir, exist_ok=True)

    def dump(name, payload):
        with open(os.path.join(data_dir, name), "w", encoding="utf-8") as f:
            json.dump(deep_mask(payload), f, ensure_ascii=False, separators=(",", ":"))

    dump("page-graph.json", {**meta, "nodes": nodes, "edges": edges,
                             "stats": {
                                 "pages": len(nodes), "edges": len(edges),
                                 "hubs": len(hub_ids),
                                 "dead_wikilink_occurrences": dead_links_total,
                                 "unresolvable_frontmatter_targets": unresolvable_conns,
                                 "frontmatter_parse_failures": len(FM_FAILS),
                                 "relation_families": FAMILY_MAP,
                             }})
    dump("evidence-index.json", {**meta, "pages": evidence_index})
    dump("sources-index.json", {**meta, "source_paths": ["wiki/", "kb/", "raw/", "testimony/"],
                                       "pages": sources_pages, "coverage": sources_coverage})
    dump("search-adapter.json", {**meta, "objects": search})
    dump("timeline.json", {**meta, "source": "wiki/timeline/master-timeline.md",
                           "events": events,
                           "stats": {"events": len(events)}})

    # ---- 8. copy app source ----
    app_src = os.path.join(root, "harness")
    if os.path.isdir(app_src):
        for item in os.listdir(app_src):
            s, d = os.path.join(app_src, item), os.path.join(out, item)
            if os.path.isdir(s):
                shutil.copytree(s, d, dirs_exist_ok=True)
            else:
                shutil.copy2(s, d)

    print(f"wb-harness: {len(nodes)} nodes, {len(edges)} edges, "
          f"{len(events)} timeline events, {len(kb_nodes)} kb nodes "
          f"-> {out} (commit {commit[:7]})")
    print(f"wb-harness: sources: {sources_coverage['unique_resolved']}/"
          f"{sources_coverage['unique_total']} unique entries resolve "
          f"({sources_coverage['unique_pct']}%)")
    if FM_FAILS:
        print(f"wb-harness: {len(FM_FAILS)} frontmatter parse failures (counted, skipped)")


if __name__ == "__main__":
    sys.exit(main())
