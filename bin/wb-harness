        ('raw/self/location/2026-06-22-ingest/Location History (Timeline)/Semantic Location History/2019/2019_FEBRUARY.json', 'raw/sammy/20260912-location-history/semantic/2019/2019_FEBRUARY.json', 'TABLE'),
