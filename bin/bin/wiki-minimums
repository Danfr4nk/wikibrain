#!/usr/bin/env python3
"""New-article minimums gate. Exits 1 if any NEW wiki article violates its tier floor.

Changed-file-scoped: only files ADDED under wiki/ vs <base> (default
origin/main) are checked — working tree vs base, so uncommitted batch work
is caught. Two tiers (frontmatter `tier:`, kind-based, length is the tripwire):

- major (default): page_type entity/synthesis/concept/event/period/profile/
  journey, status not stub/archived/closed → >= 3000 words of body text
  (a 15-minute read at 200wpm). Length comes from totality analysis,
  evidence, and complete logs; padding fails review.
- incidental: <= 1000 words, complete at its size (never a draft), and the
  body must open with the `> **Incidental entry**` badge block. The
  1000-3000 band is major-track: held to the 3000-word floor. No third tier.

Deliberately new-files-only. The pre-existing sub-floor corpus is being
reclassified (kind-incidental → badged, major-track → expansion queue),
not gate-failed — the gate enforces the tier rules for what is being
written now.

Usage:  bin/wiki-minimums [--base <git-ref>] [--repo <path>]
Standard library only. Exit 0 on pass, 1 on any tier violation.
"""

import argparse
import os
import re
import subprocess
import sys

DEFAULT_BASE = "origin/main"
MIN_WORDS = 3000
INCIDENTAL_MAX_WORDS = 1000
SUBSTANTIVE = {"entity", "synthesis", "concept", "event", "period",
               "profile", "journey"}
EXCLUDED_STATUS = {"stub", "archived", "closed"}

INCIDENTAL_BADGE_RE = re.compile(r"^>\s*\*\*Incidental entry\*\*", re.M)

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def git(*args, cwd):
    return subprocess.run(["git"] + list(args), cwd=cwd,
                          capture_output=True, text=True)


def added_wiki_files(repo, base):
    """Paths ADDED under wiki/ between <base> and the working tree.

    Covers both committed-on-branch adds and uncommitted new files:
    git diff sees the former, ls-files --others the latter (untracked
    files are invisible to git diff).
    """
    added = set()
    proc = git("diff", "--name-status", base, "--", "wiki/", cwd=repo)
    if proc.returncode != 0:
        raise SystemExit("git diff failed: %s" % proc.stderr.strip())
    for line in proc.stdout.splitlines():
        parts = line.split("\t")
        if parts[0] == "A" and len(parts) >= 2 and parts[1].endswith(".md"):
            added.add(parts[1])
    untracked = git("ls-files", "--others", "--exclude-standard", "--",
                    "wiki/", cwd=repo)
    for line in untracked.stdout.splitlines():
        if line.endswith(".md"):
            added.add(line)
    return sorted(added)


def frontmatter_field(text, field):
    """Minimal frontmatter reader: value of `field:` between the --- fences."""
    m = re.match(r"^---\s*\n(.*?)\n---\s*(\n|$)", text, re.S)
    if not m:
        return ""
    for line in m.group(1).splitlines():
        mm = re.match(r"^%s:\s*[\"']?([^\"'\n]+?)[\"']?\s*$" % field, line)
        if mm:
            return mm.group(1).strip().lower()
    return ""


def body_words(text):
    m = re.match(r"^---\s*\n.*?\n---\s*(\n|$)", text, re.S)
    body = text[m.end():] if m else text
    return len(body.split())


def body_text(text):
    m = re.match(r"^---\s*\n.*?\n---\s*(\n|$)", text, re.S)
    return text[m.end():] if m else text


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--base", default=DEFAULT_BASE,
                    help="git ref to diff against (default: %(default)s)")
    ap.add_argument("--repo", default=REPO, help="repo checkout to inspect")
    args = ap.parse_args()

    failures, checked, skipped = [], 0, 0
    for rel in added_wiki_files(args.repo, args.base):
        path = os.path.join(args.repo, rel)
        try:
            text = open(path, encoding="utf-8").read()
        except OSError as e:
            failures.append((rel, "unreadable: %s" % e))
            continue
        ptype = frontmatter_field(text, "page_type")
        status = frontmatter_field(text, "status")
        if ptype not in SUBSTANTIVE or status in EXCLUDED_STATUS:
            skipped += 1
            continue
        tier = frontmatter_field(text, "tier") or "major"
        words = body_words(text)
        checked += 1
        if tier == "incidental":
            if words > INCIDENTAL_MAX_WORDS:
                failures.append(
                    (rel, "%d words exceeds incidental cap %d"
                     % (words, INCIDENTAL_MAX_WORDS)))
            elif not INCIDENTAL_BADGE_RE.search(body_text(text)):
                failures.append((rel, "incidental entry missing "
                                      "`> **Incidental entry**` badge block"))
        elif words < MIN_WORDS:
            failures.append((rel, "%d words (floor %d)" % (words, MIN_WORDS)))

    if failures:
        print("wiki-minimums: FAIL — %d new article(s) below tier bar:"
              % len(failures))
        for rel, why in failures:
            print("  %s  %s" % (rel, why))
        return 1
    print("wiki-minimums: pass — %d new article(s) checked against tier bars "
          "(%d non-substantive/excluded skipped)."
          % (checked, skipped))
    return 0


if __name__ == "__main__":
    sys.exit(main())
