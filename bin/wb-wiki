# --------------------------------------------------------------------------
# Recent-changes crawl (ticker): a slim bar cycling the 100 most recent wiki
# changes, one at a time, fed by crawl.json (bin/wiki-crawl-feed).
# --------------------------------------------------------------------------

CRAWL_CSS = """<style>
.crawl{display:flex;align-items:center;gap:.6rem;background:#241a38;color:#efe9fb;
font-size:.8rem;padding:.3rem .8rem;min-height:32px;position:relative;z-index:20}
.crawl-label{font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
color:#c9b8f0;white-space:nowrap}
.crawl-item{flex:1;min-width:0;color:#efe9fb;text-decoration:none;white-space:nowrap;
overflow:hidden;text-overflow:ellipsis;transition:opacity .38s ease}
.crawl-item:hover{text-decoration:underline;color:#fff}
.crawl-fade .crawl-item{opacity:0}
.crawl-time{color:#9d8cc7;white-space:nowrap;font-size:.74rem}
.crawl-nav{display:flex;gap:.1rem;align-items:center}
.crawl button{background:none;border:none;color:#c9b8f0;font-size:1rem;cursor:pointer;
padding:.1rem .35rem;line-height:1;border-radius:4px}
.crawl button:hover{background:rgba(255,255,255,.12);color:#fff}
</style>"""

CRAWL_BAR = """<div class="crawl" id="crawl" data-crawl="{crawl_src}" data-root="{root_page}" role="marquee" aria-label="Recent wiki changes">
<span class="crawl-label">Recent changes</span>
<a class="crawl-item" href="#"><span class="crawl-text"></span> <span class="crawl-time"></span></a>
<span class="crawl-nav"><button type="button" data-crawl-prev aria-label="Previous change">&#8249;</button><button type="button" data-crawl-next aria-label="Next change">&#8250;</button><button type="button" data-crawl-close aria-label="Dismiss ticker">&times;</button></span>
</div>"""

CRAWL_JS = """<script>
(function(){
  var bar=document.getElementById('crawl');
  if(!bar)return;
  try{if(localStorage.getItem('wb-crawl-off')==='1'){bar.remove();return;}}catch(e){}
  var src=bar.getAttribute('data-crawl')||'crawl.json';
  var root=(bar.getAttribute('data-root')||'index.html').replace(/(index|home)\\.html$/,'');
  var link=bar.querySelector('.crawl-item'),txt=bar.querySelector('.crawl-text'),
      when=bar.querySelector('.crawl-time');
  var items=[],i=0,timer=null,token=0;
  function fmtDelta(d){return '('+(d<0?'\\u2212':'+')+Math.abs(d)+' words)';}
  function ago(iso){
    var s=Math.max(0,(Date.now()-new Date(iso).getTime())/1000);
    if(s<3600)return Math.max(1,Math.round(s/60))+'m ago';
    if(s<86400)return Math.round(s/3600)+'h ago';
    var d=Math.round(s/86400);
    if(d===1)return 'yesterday';
    if(d<30)return d+'d ago';
    return new Date(iso).toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'});
  }
  function render(){
    var it=items[i];if(!it)return;
    link.href=root+it.href;
    txt.textContent=it.title+': '+it.text+' '+fmtDelta(it.delta);
    when.textContent=ago(it.date);
  }
  function restart(){
    if(timer)clearInterval(timer);
    timer=setInterval(function(){show(i+1);},6000);
  }
  function show(n){
    if(!items.length)return;
    i=(n+items.length)%items.length;
    var t=++token;
    bar.classList.add('crawl-fade');
    setTimeout(function(){if(t!==token)return;render();bar.classList.remove('crawl-fade');},380);
    restart();
  }
  var prev=bar.querySelector('[data-crawl-prev]'),
      next=bar.querySelector('[data-crawl-next]'),
      close=bar.querySelector('[data-crawl-close]');
  if(prev)prev.addEventListener('click',function(ev){ev.preventDefault();show(i-1);});
  if(next)next.addEventListener('click',function(ev){ev.preventDefault();show(i+1);});
  if(close)close.addEventListener('click',function(){
    try{localStorage.setItem('wb-crawl-off','1');}catch(e){}
    if(timer)clearInterval(timer);
    bar.remove();
  });
  bar.addEventListener('mouseenter',function(){if(timer)clearInterval(timer);timer=null;});
  bar.addEventListener('mouseleave',function(){restart();});
  fetch(src).then(function(r){return r.json();}).then(function(j){
    items=(j&&j.items)||[];
    if(!items.length){bar.remove();return;}
    render();restart();
  }).catch(function(){bar.remove();});
})();
</script>"""


def crawl_bar(crawl_src: str, root_page: str) -> str:
    return CRAWL_BAR.format(crawl_src=crawl_src, root_page=root_page)


# --------------------------------------------------------------------------
# Images: infobox portraits + Sources thumbnail library.
#
# Authors write repo-root-absolute paths (`wiki/media/<file>`) in the
# `images:` frontmatter block and in body markdown; the builder rewrites
# them to page-relative URLs at render time. Legacy `../media/`,
# `../../media/` (and bare `media/`) body refs are normalized the same way
# so old pages keep working. Every referenced file must exist under
# wiki/media/ and must not be embed_excluded — violations fail the build
# loudly (no silent 404s on the live site).
# --------------------------------------------------------------------------

class MediaError(ValueError):
    pass


_MEDIA_FILES: set[str] | None = None
_EXCLUDED_IDS: set[str] | None = None


def _media_files() -> set[str]:
    """Relative paths of every file under wiki/media/ (e.g. 'upload-045.jpg',
    'derivatives/chat-uploads/x.jpg')."""
    global _MEDIA_FILES
    if _MEDIA_FILES is None:
        found = set()
        mdir = WIKI / "media"
        if mdir.is_dir():
            for p in mdir.rglob("*"):
                if p.is_file():
                    found.add(str(p.relative_to(mdir)))
        _MEDIA_FILES = found
    return _MEDIA_FILES


def _excluded_ids() -> set[str]:
    """Registry ids flagged embed_excluded — never embedded, ever."""
    global _EXCLUDED_IDS
    if _EXCLUDED_IDS is None:
        ids = set()
        regp = ROOT / "media" / "registry.json"
        if regp.is_file():
            try:
                reg = json.loads(regp.read_text(encoding="utf-8"))
                items = reg.get("items", []) if isinstance(reg, dict) else []
                for it in items:
                    if (isinstance(it, dict) and it.get("embed_excluded")
                            and it.get("id")):
                        ids.add(str(it["id"]))
            except (json.JSONDecodeError, OSError):
                pass
        _EXCLUDED_IDS = ids
    return _EXCLUDED_IDS


# Matches an author-written media src in all its historical forms:
# wiki/media/x.jpg, ../media/x.jpg, ../../media/x.jpg, bare media/x.jpg.
_MEDIA_PREFIX_RE = re.compile(r"^(?:(?:\.\./)*media/|wiki/media/)")
_MEDIA_REST_RE = re.compile(r"([^?#\s]*)([?#].*)?$")


def _media_relpath(src: str, page_key: str) -> str:
    """Validate `src` and return its path relative to wiki/media/.

    Raises MediaError on anything outside wiki/media/, missing files,
    or embed_excluded ids.
    """
    s = src.strip()
    m = _MEDIA_PREFIX_RE.match(s)
    if not m:
        raise MediaError(f"{page_key}: not a wiki/media path: {src!r}")
    rest = s[m.end():]
    rm = _MEDIA_REST_RE.match(rest)
    rel, suffix = rm.group(1), rm.group(2) or ""
    parts = rel.split("/")
    if not rel:
        raise MediaError(
            f"{page_key}: media path has no filename: {src!r}")
    if any(p in ("", ".", "..") for p in parts):
        raise MediaError(
            f"{page_key}: media path must stay under wiki/media/: {src!r}")
    if rel not in _media_files():
        raise MediaError(
            f"{page_key}: media file not found under wiki/media/: {src!r}")
    stem = parts[-1].rsplit(".", 1)[0]
    if stem in _excluded_ids():
        raise MediaError(
            f"{page_key}: media file is embed_excluded, refusing: {src!r}")
    return rel, suffix


def media_url(src: str, page_dir: str, page_key: str) -> str:
    """Rewrite an author-written media src to a page-relative URL.

    Non-media srcs (http, anchors, other relative paths) pass through
    untouched. Anything that *looks like* a media ref but doesn't validate
    raises MediaError — no silent 404s.
    """
    if not _MEDIA_PREFIX_RE.match(src.strip()):
        return src
    rel, suffix = _media_relpath(src, page_key)
    return os.path.relpath(os.path.join("media", rel),
                           page_dir or ".") + suffix


_BODY_MEDIA_RE = re.compile(
    r'((?:src|href)=")((?:\.\./)*media/|wiki/media/)([^"]*)"')


def rewrite_body_media(html_text: str, page_dir: str, page_key: str) -> str:
    """Normalize every media src/href in rendered body HTML to a working
    page-relative URL. Raises MediaError on missing/excluded files."""

    def sub(m: re.Match) -> str:
        url = media_url(m.group(2) + m.group(3), page_dir, page_key)
        return m.group(1) + html.escape(url, quote=True) + '"'

    return _BODY_MEDIA_RE.sub(sub, html_text)


def _frontmatter_image(src, page_key: str, where: str) -> str:
    """Validate an `images:`-listed file; return its path under wiki/media/.

    Frontmatter is new-authored, so the canonical repo-root-absolute form
    is required — legacy relative forms are rejected, not normalized.
    """
    s = str(src or "").strip()
    if not s.startswith("wiki/media/"):
        raise MediaError(
            f"{page_key}: {where} must be repo-root-absolute "
            f"wiki/media/<file>, got: {src!r}")
    rel, _ = _media_relpath(s, page_key)
    return rel


def infobox_photo_html(img, page_dir: str, page_key: str) -> str:
    if isinstance(img, str):
        img = {"file": img}
    if not isinstance(img, dict):
        raise MediaError(
            f"{page_key}: images.infobox must be a mapping or filename")
    rel = _frontmatter_image(img.get("file"), page_key, "images.infobox.file")
    href = os.path.relpath(os.path.join("media", rel), page_dir or ".")
    alt = str(img.get("alt") or img.get("caption") or rel.rsplit("/", 1)[-1])
    cap = str(img.get("caption") or "").strip()
    cap_html = f'<div class="ib-caption">{inline(cap)}</div>' if cap else ""
    return (f'<div class="ib-photo"><img src="{html.escape(href, quote=True)}" '
            f'alt="{html.escape(alt, quote=True)}" loading="lazy">'
            f"{cap_html}</div>")


def media_library_html(images: dict, page_dir: str, page_key: str) -> str:
    """Builder-generated Sources thumbnail library from images.library."""
    lib = images.get("library") if isinstance(images, dict) else None
    if not lib:
        return ""
    if not isinstance(lib, list):
        raise MediaError(f"{page_key}: images.library must be a list")
    figs = []
    for i, item in enumerate(lib):
        if isinstance(item, str):
            item = {"file": item}
        if not isinstance(item, dict):
            raise MediaError(
                f"{page_key}: images.library[{i}] must be a mapping or filename")
        where = f"images.library[{i}].file"
        rel = _frontmatter_image(item.get("file"), page_key, where)
        href = os.path.relpath(os.path.join("media", rel),
                               page_dir or ".")
        alt = str(item.get("alt") or item.get("caption")
                  or rel.rsplit("/", 1)[-1])
        cap = str(item.get("caption") or "").strip()
        kb = str(item.get("kb") or "").strip()
        cap_html = inline(cap) if cap else ""
        if kb:
            kb_html = f"<code>{html.escape(kb)}</code>"
            cap_html = f"{cap_html} {kb_html}".strip()
        figcap = f"<figcaption>{cap_html}</figcaption>" if cap_html else ""
        figs.append(
            f'<figure class="wbmedia"><a href="{html.escape(href, quote=True)}">'
            f'<img src="{html.escape(href, quote=True)}" '
            f'alt="{html.escape(alt, quote=True)}" loading="lazy"></a>'
            f"{figcap}</figure>")
    return ("<h2>Media library</h2>\n"
            '<div class="wblib">\n' + "\n".join(figs) + "\n</div>")


def infobox_html(infobox: dict, images: dict | None = None,
                 page_dir: str = "", page_key: str = "") -> str:
    photo = ""
    if isinstance(images, dict):
        img = images.get("infobox")
        if img is None:
            lib = images.get("library") or []
            if not isinstance(lib, list):
                raise MediaError(f"{page_key}: images.library must be a list")
            img = lib[0] if lib else None
        # Explicit opt-out: no portrait exists for this page; don't fall
        # back to library[0] (which may be a document scan). The
        # frontmatter parser leaves `false` as the string "false", and
        # tolerates trailing comments, so match on the first token.
        if img is False or (isinstance(img, str)
                            and img.strip().lower().split()[:1] == ["false"]):
            img = None
        if img is not None:
            photo = infobox_photo_html(img, page_dir, page_key)
    if not infobox and not photo:
        return ""
    rows = []
    title = None
    for k, v in infobox.items():
        if k in ("name", "title") and isinstance(v, str) and title is None:
            title = v
        label = k.replace("_", " ").title()
        if v is None:
            val = "—"
        elif isinstance(v, list):
            val = "<br>".join(html.escape(str(x)) for x in v)
        else:
            val = html.escape(str(v))
        rows.append(f"<tr><th>{html.escape(label)}</th><td>{val}</td></tr>")
    head = f'<div class="ib-title">{html.escape(title)}</div>' if title else ""
    return (f'<aside class="infobox">{photo}{head}<table>' +
            "".join(rows) + "</table></aside>")


def toc_html(rendered_body: str) -> str:
    heads = re.findall(r'<h([23]) id="([^"]+)">(.+?)</h\1>', rendered_body)
    if len(heads) < 4:
        return ""
    items = []
    for level, aid, text in heads:
        label = re.sub(r"<[^>]+>", "", text)
        pad = " style='margin-left:14px'" if level == "3" else ""
        items.append(f'<li{pad}><a href="#{aid}">{label}</a></li>')
    return ('<nav class="toc" aria-label="Contents"><b>Contents</b><ul>' +
            "".join(items) + "</ul></nav>")


def connections_html(conns: list, linker: WikiLinker, page_key: str,
                     pages: dict, page_dir: str) -> str:
    if not conns:
        return ""
    blocks = []
    for c in conns:
        if not isinstance(c, dict):
            continue
        target = str(c.get("page", "")).strip()
        ctype = str(c.get("type", "")).strip()
        claim = str(c.get("claim", "")).strip()
        key = norm_key(target)
        page = pages.get(key)
        if page is None:
            linker.dead.append((page_key, target))
            link = (f'<span class="deadlink" title="No such article: '
                    f'{html.escape(key)}">{html.escape(target)}</span>')
        else:
            href = os.path.relpath(page["url"], page_dir or ".")
            link = f'<a href="{html.escape(href, quote=True)}">{html.escape(page["title"])}</a>'
        type_badge = f'<span class="ctype">{html.escape(ctype)}</span>' if ctype else ""
        claim_html = f" — {inline(claim)}" if claim else ""
        blocks.append(f'<div class="conn">{type_badge}<b>{link}</b>{claim_html}</div>')
    if not blocks:
        return ""
    return "<h2>Connections</h2>\n" + "\n".join(blocks)


def see_also_html(meta: dict, linker: WikiLinker, page_key: str,
                  pages: dict, page_dir: str) -> str:
    items: list[str] = []
    for field in ("related", "synthesizes"):
        vals = meta.get(field) or []
        if isinstance(vals, str):
            vals = [vals]
        for v in vals:
            v = str(v).strip()
            if not v:
                continue
            key = norm_key(v)
            page = pages.get(key)
            if page is None:
                linker.dead.append((page_key, v))
                items.append(f'<li><span class="deadlink" title="No such article">{html.escape(v)}</span></li>')
            else:
                href = os.path.relpath(page["url"], page_dir or ".")
                items.append(f'<li><a href="{html.escape(href, quote=True)}">'
                             f'{html.escape(page["title"])}</a></li>')
    if not items:
        return ""
    return "<h2>See also</h2>\n<ul>\n" + "\n".join(items) + "\n</ul>"


def article_html(page: dict, linker: WikiLinker, pages: dict) -> str:
    meta = page["meta"]
    page_dir = os.path.dirname(page["url"])
    body_src = linker.resolve(page["body"], page["key"], pages)
    rendered = markdown(body_src)
    rendered = linker.render_tokens(rendered, page["key"], pages, page_dir)
    rendered = rewrite_body_media(rendered, page_dir, page["key"])

    domain = str(meta.get("domain", "") or "")
    ptype = str(meta.get("page_type", "") or "")
    subtitle_bits = [b for b in (domain, ptype) if b]
    aliases = meta.get("aliases") or []
    if isinstance(aliases, str):
        aliases = [aliases]
    subtitle = " · ".join(subtitle_bits)
    if aliases:
        subtitle += " — also known as " + ", ".join(html.escape(str(a)) for a in aliases)

    toc = toc_html(rendered)
    conns = connections_html(meta.get("connections") or [], linker,
                             page["key"], pages, page_dir)
    see_also = see_also_html(meta, linker, page["key"], pages, page_dir)
    images = meta.get("images") or {}
    if not isinstance(images, dict):
        raise MediaError(f"{page['key']}: images: must be a mapping")
    media_lib = media_library_html(images, page_dir, page["key"])

    tags = meta.get("tags") or []
    if isinstance(tags, str):
        tags = [tags]
    tags_html = ""
    if tags:
        chips = "".join(f'<span class="tag">{html.escape(str(t))}</span>' for t in tags)
        tags_html = f'<div class="tags">{chips}</div>'

    foot_rows = []
    for label, fkey in (("Status", "status"), ("Knowledge", "knowledge"),
                        ("Importance", "importance"),
                        ("Created", "date_created"), ("Modified", "date_modified")):
        v = meta.get(fkey)
        if v:
            foot_rows.append(f"<dt>{label}</dt><dd>{html.escape(str(v))}</dd>")
    dr0, dr1 = meta.get("date_range_start"), meta.get("date_range_end")
    if dr0 or dr1:
        foot_rows.append(f"<dt>Date range</dt><dd>{html.escape(str(dr0 or '?'))} → "
                         f"{html.escape(str(dr1 or '?'))}</dd>")
    sources = meta.get("sources") or []
    if isinstance(sources, str):
        sources = [sources]
    if sources:
        src_list = "".join(f"<li><code>{html.escape(str(s))}</code></li>" for s in sources)
        foot_rows.append(f"<dt>Sources ({len(sources)})</dt><dd><ul>{src_list}</ul></dd>")

    up = os.path.relpath("home.html", os.path.join("wiki", page_dir or "."))

    return f"""<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{html.escape(page['title'])} — Wiki Brain</title>
{CSS}
{CRAWL_CSS}</head>
<body>
{crawl_bar("../crawl.json", "../home.html")}
<div class="mast"><b><a href="{html.escape(up, quote=True)}">Wiki Brain</a></b>
<span class="crumb">{html.escape(domain)} / {html.escape(ptype)}</span></div>
<div class="wrap">
{infobox_html(meta.get("infobox") or {}, images, page_dir, page["key"])}
<h1>{html.escape(page['title'])}</h1>
<p class="subtitle">{subtitle}</p>
{toc}
{rendered}
{conns}
{see_also}
{tags_html}
<div class="clear"></div>
{media_lib}
<div class="metafoot"><dl>
{"".join(foot_rows)}
</dl></div>
</div>
<div class="footer">Wiki Brain article · {html.escape(page['key'])} ·
<a href="{html.escape(up, quote=True)}">front page</a></div>
{CRAWL_JS}
</body></html>
"""


# --------------------------------------------------------------------------
# Front page, domain indexes, search index
# --------------------------------------------------------------------------

def front_page(pages: list[dict], counts: dict[str, int]) -> str:
    # Share copies (wiki/share/) render standalone and ungated. They are excluded
    # from the newest/modified lists but get their own public snapshot section.
    shown = [p for p in pages
             if str(p["meta"].get("shared") or "").lower() != "true"]
    shared = sorted(
        (p for p in pages
         if str(p["meta"].get("shared") or "").lower() == "true"),
        key=lambda p: str(p["meta"].get("shared_at") or ""),
        reverse=True)
    shared_items = "\n".join(
        f'<div><a href="wiki/{p["url"]}">{html.escape(p["title"])}</a> '
        f'<small>snapshot of {html.escape(str(p["meta"].get("shared_from") or ""))} · '
        f'{html.escape(str(p["meta"].get("shared_at") or ""))}</small></div>'
        for p in shared)
    shared_section = ""
    if shared_items:
        shared_section = f"""<h2 class="sec">Shared pages</h2>
<p style="color:var(--mut);font-size:14px">Public, ungated snapshots of selected
articles — safe to send to anyone. Links to other wiki entries are flattened;
the cliff notes at the bottom of each page carry the context they would have
provided.</p>
<div class="newlist">{shared_items}</div>"""
    newest = sorted(shown, key=lambda p: str(p["meta"].get("date_created") or ""),
                    reverse=True)[:12]
    new_items = "\n".join(
        f'<div><a href="wiki/{p["url"]}">{html.escape(p["title"])}</a> '
        f'<small>{html.escape(str(p["meta"].get("date_created") or ""))} · '
        f'{html.escape(str(p["meta"].get("domain") or ""))}</small></div>'
        for p in newest)

    modified = sorted(shown, key=lambda p: str(p["meta"].get("date_modified") or ""),
                      reverse=True)[:25]
    mod_items = "\n".join(
        f'<div><a href="wiki/{p["url"]}">{html.escape(p["title"])}</a> '
        f'<small>{html.escape(str(p["meta"].get("date_modified") or ""))} · '
        f'{html.escape(str(p["meta"].get("domain") or ""))}</small></div>'
        for p in modified)

    cards = "\n".join(
        f'<a class="dcard" href="domains/{d}.html"><b>{d.title()}</b><br>'
        f'<span class="n">{counts.get(d, 0)} articles</span></a>'
        for d in DOMAINS if counts.get(d))

    layers = " ".join(
        f'<a href="layer-{i}.html">Layer {i}</a>' for i in range(6))

    return f"""<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wiki Brain</title>
{FRONT_CSS}
{CRAWL_CSS}</head>
<body>
{crawl_bar("crawl.json", "home.html")}
<div class="hero">
<h1>Wiki Brain</h1>
<p>{len(pages)} articles · people, timeline, places, work, mind, legal, health, interests, self, meta</p>
<div class="search">
<input id="q" type="search" placeholder="Search {len(pages)} articles…" autocomplete="off">
<button onclick="doSearch()">Search</button>
</div>
<div id="results"></div>
</div>
<div class="wrap">
<h2 class="sec">Two sides of the same brain</h2>
<p style="color:var(--mut);font-size:14px">Every article exists twice, with the same
information &mdash; narrative form for humans, structured form for agents and LLMs.
Both render from the same source in the same build, so they can&apos;t drift apart.</p>
<div class="dgrid">
<a class="dcard" href="#browse"><b>Read</b><br><span class="n">the human articles, in narrative form</span></a>
<a class="dcard" href="llms.txt"><b>Agent mirror</b><br><span class="n">{len(pages)} articles, machine-optimized</span></a>
</div>
<h2 class="sec" id="browse">Browse by domain</h2>
<div class="dgrid">{cards}</div>
{shared_section}
<h2 class="sec">Beyond the articles</h2>
<p style="color:var(--mut);font-size:14px">The peripheral machinery around the
wiki &mdash; other ways in, other ways to read it, frozen snapshots of what it
used to be.</p>
<div class="dgrid">
<a class="dcard" href="harness/"><b>The Harness</b><br><span class="n">the read-only exploration layer &mdash; Explore, Journey, Time, Evidence and Search views over the whole wiki and its evidence nodes</span></a>
<a class="dcard" href="portal/"><b>The Portal</b><br><span class="n">DAN FRANK &mdash; WIKI-BRAIN PORTAL: nine tabs &mdash; the Sage, Words, the Lattice, Leviathan, the Gallery, the Transcript, the Arcade, Transmissions</span></a>
<a class="dcard" href="archive/"><b>The Archive</b><br><span class="n">the 497-page wiki as it stood on September 4, 2026 &mdash; frozen, browsable, byte-for-byte</span></a>
<a class="dcard" href="graph.json"><b>The Graph</b><br><span class="n">every node and edge of the knowledge graph as raw JSON</span></a>
<a class="dcard" href="corpus.txt"><b>The Corpus</b><br><span class="n">the entire wiki as one plaintext file, for whoever wants a single URL</span></a>
</div>
<h2 class="sec">Newest articles</h2>
<div class="newlist">{new_items}</div>
<h2 class="sec">Recently modified</h2>
<div class="newlist">{mod_items}</div>
<h2 class="sec">The evidence layers</h2>
<p style="color:var(--mut);font-size:14px">The kb/ knowledge graph underneath the
articles — nodes, typed edges and the layer rule
("a node may cite only nodes at a strictly lower layer").</p>
<div class="layers">{layers}</div>
<div class="gov"><b>Governance.</b> Articles are written from primary evidence
(raw messages, exports, documents). Confidence and knowledge state are labeled
on every article; the evidence layers carry the fine-grained citation graph.</div>
<p class="machine">Machine-readable: <a href="llms.txt">llms.txt</a> ·
<a href="graph.json">graph.json</a> · <a href="wiki-index.json">article index</a> ·
<a href="agent/wiki.json">agent mirror</a> ·
<a href="agent/START-HERE.md">agent start here</a></p>
</div>
<div class="footer">Wiki Brain — {len(pages)} articles rendered from wiki/</div>
<script>
let IDX=[];
fetch('wiki-index.json').then(r=>r.json()).then(j=>{{IDX=j;}});
const box=document.getElementById('q'), res=document.getElementById('results');
function doSearch(){{
  const q=box.value.trim().toLowerCase();
  if(q.length<2){{res.innerHTML='';return;}}
  const hits=IDX.filter(e=>(e.t+' '+(e.a||[]).join(' ')+' '+(e.g||[]).join(' ')).toLowerCase().includes(q)).slice(0,15);
  res.innerHTML=hits.length
    ? hits.map(h=>'<div class="hit"><a href="wiki/'+h.u+'">'+h.t+'</a> <small>'+h.d+' · '+h.y+'</small></div>').join('')
    : '<div class="hit">No matches.</div>';
}}
box.addEventListener('input',doSearch);
</script>
{CRAWL_JS}
</body></html>
"""


def domain_page(domain: str, pages: list[dict]) -> str:
    rows = "\n".join(
        f'<div><a href="../wiki/{p["url"]}">{html.escape(p["title"])}</a> '
        f'<small>{html.escape(str(p["meta"].get("page_type") or ""))} · '
        f'{html.escape(str(p["meta"].get("date_modified") or ""))}</small></div>'
        for p in sorted(pages, key=lambda p: p["title"].lower()))
    return f"""<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{domain.title()} — Wiki Brain</title>
{FRONT_CSS}
{CRAWL_CSS}</head>
<body>
{crawl_bar("../crawl.json", "../home.html")}
<div class="wrap">
<p><a href="../home.html">Wiki Brain</a> / {html.escape(domain)}</p>
<h1 style="font-family:Georgia,serif;font-weight:400">{domain.title()}
<small style="font-size:.5em;color:var(--mut)">{len(pages)} articles</small></h1>
<div class="newlist">{rows}</div>
</div>
<div class="footer"><a href="../home.html">Wiki Brain front page</a></div>
{CRAWL_JS}
</body></html>
"""


# --------------------------------------------------------------------------
# Agent mirror (three-surface publishing, 2026-09-22).
#
# For every human article at site/wiki/<path>.html, emit a deterministic
# agent-optimized mirror at site/agent/wiki/<path>.md: the SAME information,
# structured for fast machine consumption (metadata header, summary, entity
# index, connections, section outline, full text). The mirror is DERIVED from
# the human article's page dict at build time — never separately authored —
# so the two surfaces cannot drift. No factual assertion is ever dropped: the
# optimization is structure and scannability, not deletion.
#
# wb-gate only processes *.html, so the .md mirrors publish ungated by
# construction. bin/wb-build owns site/llms.txt's kb sections and
# site/agent/manifest.json; this builder only owns the marker-delimited
# "Wiki articles" block of llms.txt (idempotent: replaced on re-run, appended
# if absent) and writes site/agent/wiki.json, the machine-readable article
# index. Redaction: page dicts arrive from load_pages() already masked by the
# wb-archive rule, so the mirror inherits exactly the human surface's masking.
# --------------------------------------------------------------------------

AGENT_BASE = "https://danfr4nk.github.io/wikibrain"
LLMS_BLOCK_START = "<!-- wb-wiki:agent-articles:start -->"
LLMS_BLOCK_END = "<!-- wb-wiki:agent-articles:end -->"

_AGENT_META_KEYS = ("domain", "page_type", "status", "knowledge",
                    "importance", "date_created", "date_modified",
                    "date_range_start", "date_range_end")


def _agent_clean_wikilink(m: re.Match) -> str:
    inner = m.group(1).strip().replace("\\|", "\x00")
    segs = inner.split("|", 1)
    if len(segs) == 2:
        label = segs[1].replace("\x00", "|").strip()
        return label or segs[0].replace("\x00", "|").strip()
    target = segs[0].replace("\x00", "|").strip()
    if target.startswith("#"):
        return target[1:]
    # prettify the last path segment: wiki/people/annie-ulmer -> annie ulmer
    name = target.split("/")[-1]
    return name.replace("-", " ").replace("_", " ").strip() or target


def agent_clean_body(body: str) -> str:
    """Strip to plain readable text. Deterministic; drops nothing factual."""
    text = re.sub(r"<!--.*?-->", "", body, flags=re.S)          # html comments
    # Protect `code spans`: they sometimes document the [[..]] syntax itself.
    codes: list[str] = []
    def _stash(m: re.Match) -> str:
        codes.append(m.group(0))
        return f"\x00CODE{len(codes) - 1}\x00"
    text = re.sub(r"`[^`\n]+`", _stash, text)
    text = re.sub(r"\[\[([^\]]+)\]\]\(([^)]+)\)", r"\1", text)  # [[label]](url)
    text = WIKILINK_RE.sub(_agent_clean_wikilink, text)         # [[..]] -> label
    # Markdown image-link [![alt](src)](href): inner image first, or the
    # outer ] dangles and the link regex below can't match across it.
    text = re.sub(r"\[!\[([^\]]*)\]\(([^)]+)\)\]\(([^)]+)\)",
                  r"[image: \1]", text)
    text = re.sub(r"!\[([^\]]*)\]\(([^)]+)\)", r"[image: \1]", text)
    text = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r"\1", text)     # [label](url)
    text = re.sub(r"\x00CODE(\d+)\x00",
                  lambda m: codes[int(m.group(1))], text)
    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()


def agent_lede(body: str, limit: int = 300) -> str:
    """First paragraph block, skipping headings. Epigraph blockquotes count:
    the human renderer styles leading blockquotes as the lede. Boilerplate
    domain breadcrumbs ("*Part of the X domain — concept.*") are skipped:
    they describe the shelf, not the article."""
    for para in re.split(r"\n\s*\n", body):
        lines = [re.sub(r"^>\s?", "", ln).strip()
                 for ln in para.strip().split("\n")]
        lines = [ln for ln in lines if ln]
        if not lines or lines[0].startswith("#"):
            continue
        text = agent_clean_body(" ".join(lines))
        if re.fullmatch(r"\*Part of the .+", text):
            continue
        if len(text) > limit:
            cut = text.rfind(". ", 0, limit)
            text = text[:cut + 1] if cut > limit // 2 else text[:limit].rstrip() + "…"
        return text
    return ""


def agent_entities(body: str) -> list[str]:
    """Ordered-deduped wikilink targets: the article's named-entity index."""
    targets: list[str] = []
    for m in WIKILINK_RE.finditer(body):
        inner = m.group(1).strip().replace("\\|", "\x00")
        target = inner.split("|", 1)[0].replace("\x00", "|").strip()
        if not target or target.startswith("#") or target.startswith("raw/") \
                or target.lower().startswith("image:"):
            continue
        if target not in targets:
            targets.append(target)
    return targets


def agent_page(p: dict) -> str:
    """Deterministic agent rendering of one article page dict."""
    meta = p["meta"]
    body = p["body"]
    lede = agent_lede(body)
    entities = agent_entities(body)
    sections = [(len(m.group(1)), m.group(2).strip())
                for m in re.finditer(r"^(#{1,6})\s+(.+)$", body, re.M)]
    words = len(body.split())

    L: list[str] = [f"# {p['title']}", "",
        "> Agent mirror. Same information as the human article, structured for fast machine consumption.",
        "> Derived deterministically at build time from the human article — never separately authored.",
        f"> Human version: {AGENT_BASE}/wiki/{p['url']}",
        f"> Canonical key: {p['key']}", "",
        "## Metadata"]
    for k in _AGENT_META_KEYS:
        v = meta.get(k)
        if v not in (None, ""):
            L.append(f"- {k}: {v}")
    for k in ("tags", "aliases"):
        v = meta.get(k)
        if isinstance(v, str):
            v = [v]
        if v:
            L.append(f"- {k}: {', '.join(str(x) for x in v)}")
    L.append(f"- word_count: {words}")
    L += ["", "## Summary", lede or "(no summary extractable)", ""]
    if entities:
        L += ["## Entities referenced",
              *("- " + e for e in entities), ""]
    conns = meta.get("connections") or []
    if isinstance(conns, list) and conns:
        L.append("## Connections")
        for c in conns:
            if isinstance(c, dict):
                claim = agent_clean_body(c.get("claim", "") or "")
                L.append(f"- {c.get('page', '?')} ({c.get('type', '?')}): "
                         f"{claim}".strip())
            else:
                L.append(f"- {c}")
        L.append("")
    if sections:
        L += ["## Sections",
              *("- " + "  " * (lvl - 1)
                + WIKILINK_RE.sub(_agent_clean_wikilink, t)
                for lvl, t in sections), ""]
    L += ["## Full text", agent_clean_body(body), ""]
    return "\n".join(L) + "\n"


def agent_url_of(p: dict) -> str:
    return f"agent/wiki/{p['url'][:-len('.html')]}.md"


def build_agent_mirror(out: pathlib.Path, pages: list[dict]) -> list[dict]:
    """Render every article's agent mirror; return the index records."""
    records = []
    for p in pages:
        rel = agent_url_of(p)
        dest = out / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(agent_page(p), encoding="utf-8")
        records.append({
            "key": p["key"],
            "title": p["title"],
            "summary": agent_lede(p["body"], limit=160).replace("\n", " "),
            "human_url": f"{AGENT_BASE}/wiki/{p['url']}",
            "agent_url": f"{AGENT_BASE}/{rel}",
            "domain": str(p["meta"].get("domain") or ""),
            "page_type": str(p["meta"].get("page_type") or ""),
            "date_modified": str(p["meta"].get("date_modified") or ""),
        })
    (out / "agent" / "wiki.json").write_text(
        json.dumps(records, indent=1) + "\n", encoding="utf-8")

    # Plain-text menu: one article per line, no JSON parsing needed.
    # Format: title | agent_url
    (out / "agent" / "index.txt").write_text(
        "\n".join(f"{r['title']} | {r['agent_url']}"
                   for r in sorted(records, key=lambda r: r["title"].lower()))
        + "\n", encoding="utf-8")

    # Dead-simple instructions for the weakest reader. Plain markdown,
    # three steps, no jargon.
    (out / "agent" / "START-HERE.md").write_text(
        f"""# Wiki Brain — agent start here

This is the agent mirror of the Wiki Brain: {len(records)} articles about one
person (Dan Frank). Each article carries the same information as the
human-readable version, structured for fast machine consumption.

## Use this in 3 steps

1. Pick what to read. Simplest menu is the plain-text index:
   {AGENT_BASE}/agent/index.txt
   One article per line: `title | url`. No JSON parsing needed.
   (JSON version, if you prefer it: {AGENT_BASE}/agent/wiki.json)
2. Fetch the article URL. Every article is plain markdown. No JavaScript,
   no login, no cookies.
3. Each article starts with metadata and a summary, then entities,
   connections, and the full text. If you only receive the first part,
   you still have the essentials.

## Rules of this corpus

- Every agent article is derived from the human article at build time.
  Same information, different form. They cannot disagree.
- Confidence and knowledge state are labeled on every article. Trust the labels.
- Human versions live under {AGENT_BASE}/wiki/ — same tree, .html instead of .md.
""", encoding="utf-8")

    block = "\n".join([
        LLMS_BLOCK_START, "",
        "## Wiki articles — agent mirrors", "",
        "Every article below has an agent-optimized mirror: the same information as the",
        "human page, structured for fast machine consumption (metadata, summary, entity",
        "index, connections, section outline, full text). Derived deterministically at",
        "build time from the human article — never separately authored, so the two",
        "surfaces cannot drift.", "",
        f"- [START HERE — read this first]({AGENT_BASE}/agent/START-HERE.md)", "",
        f"- [Plain-text article index, one per line]({AGENT_BASE}/agent/index.txt)", "",
        f"- [Article index (JSON)]({AGENT_BASE}/agent/wiki.json)", "",
        *[f"- [{r['title']}]({r['agent_url']}): {r['summary'] or '(no summary)'}"
          for r in sorted(records, key=lambda r: r["title"].lower())],
        "", LLMS_BLOCK_END,
    ])
    llms = out / "llms.txt"
    if llms.exists():
        text = llms.read_text(encoding="utf-8")
        pat = re.compile(re.escape(LLMS_BLOCK_START) + r".*?"
                         + re.escape(LLMS_BLOCK_END), re.S)
        text = pat.sub(lambda _: block, text) if pat.search(text) \
            else text.rstrip("\n") + "\n\n" + block + "\n"
    else:
        text = "# Wiki Brain\n\n" + block + "\n"
    llms.write_text(text, encoding="utf-8")
    return records


# --------------------------------------------------------------------------
# Splash page: the wiki's front door (site/index.html)
# --------------------------------------------------------------------------

SPLASH_FLOW_JS = """<script>
(function(){
"use strict";
var DIGEST="__WB_SPLASH_DIGEST__",KEY="wb_gate_v1";
function go(){location.href="home.html";}
document.addEventListener("wiki:enter",function(){
  /* entry sets the shared session key so the wb-gate'd pages open
     without re-prompting — the 20-tap sequence IS the gate now.
     No hint or progress is shown: the entry code is secret. */
  try{if(DIGEST)sessionStorage.setItem(KEY,DIGEST);}catch(e){}
  go();
});
})();
</script>"""


def splash_page() -> str:
    """Full-screen galaxy-charge splash with the 20-tap entry.

    Entry = 20 quick taps on or above the WIKI BRAIN wordmark within
    10 seconds of the first tap. The twentieth tap fires wiki:enter,
    which sets the shared sessionStorage key (wb_gate_v1) so the gated
    pages open without re-prompting, then lands on home.html. No hint
    or progress is shown: the entry code is secret. Hold-to-charge /
    release-to-detonate stays as pure spectacle. When WB_GATE_PASSWORD
    is unset at build time there is no digest and entry goes straight
    through.
    """
    gal = (ROOT / "assets" / "galaxy-charge.js").read_text(encoding="utf-8")
    password = os.environ.get("WB_GATE_PASSWORD", "")
    digest = hashlib.sha256(password.encode("utf-8")).hexdigest() if password else ""
    flow = SPLASH_FLOW_JS.replace("__WB_SPLASH_DIGEST__", digest)
    return (
        "<!DOCTYPE html>\n"
        '<html lang="en"><head><meta charset="utf-8">\n'
        '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
        "<title>Wiki Brain</title>\n"
        "<!-- wb-gate-skip: the splash runs its own 20-tap step and sets the shared session key -->\n"
        '<link rel="preconnect" href="https://fonts.googleapis.com">\n'
        '<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>\n'
        '<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@900&display=swap" rel="stylesheet">\n'
        "<style>\n"
        "html,body{margin:0;padding:0;height:100%;background:#000;overflow:hidden}\n"
        "galaxy-charge{position:fixed;inset:0;display:block;z-index:0}\n"
        "</style>\n"
        + CRAWL_CSS + "\n"
        "</head>\n<body>\n"
        + crawl_bar("crawl.json", "home.html") + "\n"
        "<galaxy-charge></galaxy-charge>\n"
        "<script>\n" + gal + "\n</script>\n"
        + flow + "\n"
        + CRAWL_JS + "\n"
        "</body></html>\n"
    )


# --------------------------------------------------------------------------
# Loading
# --------------------------------------------------------------------------

def collect_targets(pages: list[dict]) -> set[str]:
    """All wiki/ link targets referenced by bodies and frontmatter lists."""
    targets: set[str] = set()

    def add(raw: str) -> None:
        tmp = raw.replace("\\|", "\x00PIPE\x00")
        t = tmp.split("|", 1)[0].split("\x00PIPE\x00", 1)[0]
        t = t.replace("\x00PIPE\x00", "|").strip()
        t = t.split("#", 1)[0].strip()
        if t.startswith("wiki/"):
            targets.add(norm_key(t))

    for p in pages:
        for m in WIKILINK_RE.finditer(p["body"]):
            add(m.group(1))
        for m in MDLINK_RE.finditer(p["body"]):
            if m.group(2).startswith(("wiki/", "/wiki/")):
                add(m.group(2))
        meta = p["meta"]
        for c in meta.get("connections") or []:
            if isinstance(c, dict) and str(c.get("page", "")).strip():
                add(str(c["page"]))
        for field in ("related", "synthesizes"):
            vals = meta.get(field) or []
            if isinstance(vals, str):
                vals = [vals]
            for v in vals:
                if str(v).strip():
                    add(str(v))
    return targets


def directory_index_page(key: str) -> dict | None:
    """Auto-generated listing page for a linked directory with no index page."""
    rel = key[len("wiki/"):]
    d = WIKI / rel
    if not rel or not d.is_dir():
        return None
    kids = sorted(c.stem for c in d.iterdir() if c.suffix == ".md")
    subs = sorted(c.name for c in d.iterdir() if c.is_dir())
    lines = [f"This section of the wiki has no index article of its own. "
             f"Pages filed under **{rel}**:"]
    lines += [f"- [[wiki/{rel}/{k}]]" for k in kids]
    if subs:
        lines.append("")
        lines.append("Subsections:")
        lines += [f"- [[wiki/{rel}/{s}]]" for s in subs]
    return {
        "key": key,
        "url": rel + ".html",
        "title": prettify(rel.split("/")[-1]) + " — index",
        "meta": {"domain": rel.split("/")[0], "page_type": "index",
                 "status": "generated"},
        "body": "\n".join(lines),
    }


def load_pages() -> list[dict]:
    pages = []
    for path in sorted(WIKI.rglob("*.md")):
        rel = path.relative_to(WIKI)
        key = "wiki/" + str(rel.with_suffix(""))
        text = path.read_text(encoding="utf-8")
        m = re.match(r"^---\n(.*?)\n---\n(.*)$", text, re.S)
        if m:
            fm_text, body = m.group(1), m.group(2)
            # A few files have body blockquotes inserted inside the
            # frontmatter segment; lift them back to the top of the body.
            fm_lines, prefix = [], []
            for line in fm_text.split("\n"):
                (prefix if line.strip().startswith(">") else fm_lines).append(line)
            try:
                meta = parse_frontmatter("\n".join(fm_lines))
            except FMError as e:
                print(f"warn: frontmatter parse failed for {key}: {e}", file=sys.stderr)
                meta, prefix = {}, []
            body = "\n".join(prefix + [body])
        else:
            meta, body = {}, text
        if not isinstance(meta, dict):
            meta = {}

        title = str(meta.get("title") or "").strip()
        if not title:
            hm = re.search(r"^#\s+(.+)$", body, re.M)
            title = hm.group(1).strip() if hm else prettify(rel.stem)

        # `key` stays unmasked: it is the wikilink resolution target and must
        # keep matching what pages write in [[...]]. `url` is the published
        # path, and every href and output filename is derived from it, so
        # masking it here masks all of them from one place — the two pages
        # named for a phone number (people/tuquick-…, people/bryan-…) would
        # otherwise publish in the URL what the body no longer prints.
        pages.append({
            "key": key,
            "url": safe(str(rel.with_suffix(".html"))),
            "title": redact(title),
            "meta": redact_meta(meta),
            "body": redact(body),
        })
    return pages


# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------

def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", default="site",
                    help="output directory (default: site)")
    args = ap.parse_args()
    out = pathlib.Path(args.out)
    out.mkdir(parents=True, exist_ok=True)

    pages = load_pages()
    by_key = {p["key"]: p for p in pages}

    # Auto-generate index pages for linked directories that have no page
    # of their own (e.g. [[wiki/interests/music]]); iterate because a
    # generated index can itself link to subdirectories.
    while True:
        new = [directory_index_page(k)
               for k in sorted(collect_targets(pages) - set(by_key))]
        new = [d for d in new if d is not None]
        if not new:
            break
        pages.extend(new)
        by_key.update({d["key"]: d for d in new})

    dupes = len(pages) - len(by_key)
    if dupes:
        print(f"warn: {dupes} duplicate page keys", file=sys.stderr)

    linker = WikiLinker()
    wiki_dir = out / "wiki"
    for p in pages:
        dest = wiki_dir / p["url"]
        dest.parent.mkdir(parents=True, exist_ok=True)
        try:
            dest.write_text(article_html(p, linker, by_key), encoding="utf-8")
        except MediaError as e:
            print(f"wb-wiki: BUILD FAILED: {e}", file=sys.stderr)
            return 1

    # Agent mirror: deterministic per-article .md under site/agent/, plus the
    # marker-delimited "Wiki articles" block of site/llms.txt and
    # site/agent/wiki.json. Built from the same page dicts as the human
    # surface, in the same run, so the two targets cannot drift.
    agent_records = build_agent_mirror(out, pages)

    # Search index (share copies excluded: standalone pages, no navigation)
    index = []
    for p in pages:
        if str(p["meta"].get("shared") or "").lower() == "true":
            continue
        meta = p["meta"]
        tags = meta.get("tags") or []
        aliases = meta.get("aliases") or []
        if isinstance(tags, str):
            tags = [tags]
        if isinstance(aliases, str):
            aliases = [aliases]
        index.append({
            "u": p["url"],
            "t": p["title"],
            "d": str(meta.get("domain") or ""),
            "y": str(meta.get("page_type") or ""),
            "m": str(meta.get("date_modified") or ""),
            "g": [str(t) for t in tags],
            "a": [str(a) for a in aliases],
        })
    (out / "wiki-index.json").write_text(json.dumps(index), encoding="utf-8")

    # Domain indexes
    counts: dict[str, int] = {}
    dom_dir = out / "domains"
    dom_dir.mkdir(exist_ok=True)
    for d in DOMAINS:
        dp = [p for p in pages if str(p["meta"].get("domain") or "") == d]
        counts[d] = len(dp)
        if dp:
            (dom_dir / f"{d}.html").write_text(domain_page(d, dp), encoding="utf-8")

    # Front door (home.html) + splash (index.html). The splash is the entry
    # point: galaxy, tap-to-enter, password; the front door holds search,
    # domains, newest. (Replaces the kb overview; layer pages stay linked.)
    (out / "home.html").write_text(front_page(pages, counts), encoding="utf-8")
    (out / "index.html").write_text(splash_page(), encoding="utf-8")

    # crawl.json — the recent-changes ticker feed. Best-effort: a feed
    # failure must never break the build (the ticker removes itself).
    try:
        import subprocess as _sp
        _r = _sp.run(
            [sys.executable, str(ROOT / "bin" / "wiki-crawl-feed"),
             "--out", str(out / "crawl.json"), "--limit", "100"],
            cwd=ROOT, capture_output=True, text=True, timeout=300)
        if _r.returncode != 0:
            print(f"crawl feed: generator failed: {_r.stderr.strip()[-200:]}",
                  file=sys.stderr)
    except Exception as e:
        print(f"crawl feed skipped: {e}", file=sys.stderr)

    # Media: compressed derivatives embedded in articles live under wiki/media/
    # and are referenced relatively (e.g. ../media/<id>.jpg from wiki/people/).
    import shutil
    media_src = ROOT / "wiki" / "media"
    if media_src.is_dir():
        shutil.copytree(media_src, out / "wiki" / "media", dirs_exist_ok=True)

    # Share apps: standalone HTML files under wiki/share/ (interactive
    # deliverables, not articles) are copied verbatim to site/wiki/share/.
    # bin/wb-gate skips everything under site/wiki/share/, so these publish
    # ungated by design.
    share_src = ROOT / "wiki" / "share"
    if share_src.is_dir():
        for f in sorted(share_src.glob("*.html")):
            (out / "wiki" / "share").mkdir(parents=True, exist_ok=True)
            shutil.copy2(f, out / "wiki" / "share" / f.name)
            print(f"share app: {f.name} -> wiki/share/")

    # Dead-link report
    dead = sorted(set(linker.dead))
    if dead:
        print(f"\ndead wikilinks: {len(dead)}", file=sys.stderr)
        for frm, tgt in dead:
            print(f"  {frm} -> [[{tgt}]]", file=sys.stderr)
    print(f"rendered {len(pages)} articles -> {out}/wiki/ "
          f"({len(dead)} dead wikilinks, {len(set(linker.raw_refs))} raw refs)")
    print(f"agent mirror: {len(agent_records)} mirrors -> {out}/agent/wiki/ "
          f"+ wiki.json + llms.txt block")
    return 0


if __name__ == "__main__":
    sys.exit(main())
