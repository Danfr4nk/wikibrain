#!/usr/bin/env python3
"""Render the wiki/ article corpus into site/wiki/ (standard library only).

Reads wiki/**/*.md — YAML-subset frontmatter plus a markdown body using
[[wiki/path|label]] wikilinks — and produces a Wikipedia-style reading
surface:

  site/wiki/<path>.html   one article per page: title, infobox, TOC,
                          full body, connections, tags, metadata footer
  site/agent/wiki/<path>.md  agent mirror: same information as the human
                          article, structured for fast machine consumption
                          (metadata, summary, entity index, connections,
                          section outline, full text). Derived
                          deterministically at build time — never separately
                          authored — so the two surfaces cannot drift.
  site/agent/wiki.json    machine-readable index of all articles
  site/llms.txt           "Wiki articles" block appended (marker-delimited;
                          bin/wb-build owns the kb sections)
  site/wiki-index.json    title/domain/tag index for client-side search
  site/domains/<d>.html   per-domain article indexes
  site/index.html         the splash front door (galaxy-charge canvas,
                          tap-to-enter, password step, recent-changes ticker)
  site/home.html          the wiki front door (search, domains, newest;
                          the kb layer pages are linked as "evidence layers")

Wikilinks with no target page are reported on stderr (dead-link report).
The build does not fail on them — the report is the control.

Usage:
  bin/wb-wiki              build into site/ (expects site/ to exist)
  bin/wb-wiki --out DIR    build into DIR
"""

from __future__ import annotations

import argparse
import hashlib
import html
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
WIKI = ROOT / "wiki"


# --------------------------------------------------------------------------
# Contact-identifier redaction.
#
# `bin/wb-archive` owns the masking rule and `bin/wb-corpus` imports it rather
# than reimplementing it, so the archive HTML and the plaintext corpus cannot
# disagree about what was masked (dat:0052). This renderer was never wired to
# it, which meant the rule held on the 497-page snapshot and the .txt corpus
# and silently did not hold on the live wiki/ articles: at the time this was
# added, site/wiki/ published 105 distinct phone numbers across 145 pages and
# 31 email addresses, while site/archive/ published none. `tests/test-census`
# asserts the plaintext is clean, which is why the hole survived — nothing
# asserted anything about the HTML.
#
# Same import idiom as wb-corpus, for the same reason: one rule, three
# surfaces, no second copy to drift.
# --------------------------------------------------------------------------

def _archive_module():
    spec = importlib.util.spec_from_loader(
        "wb_archive",
        importlib.machinery.SourceFileLoader("wb_archive",
                                             str(ROOT / "bin" / "wb-archive")))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


_ARCHIVE = _archive_module()
redact = _ARCHIVE.redact
safe = _ARCHIVE.safe


def redact_meta(value):
    """Apply `redact` through parsed frontmatter, leaving structure alone.

    Applied after parsing rather than to the raw text on purpose: masking
    before the frontmatter is read would turn `handles: ["+1..."]` into
    something the parser has to re-interpret, and a mask that can change how
    a document parses is a second bug waiting behind the first.
    """
    if isinstance(value, str):
        return redact(value)
    if isinstance(value, list):
        return [redact_meta(v) for v in value]
    if isinstance(value, dict):
        return {k: redact_meta(v) for k, v in value.items()}
    return value


# --------------------------------------------------------------------------
# Minimal YAML-subset parser for wiki/ frontmatter.
# Block mappings/sequences, sequences of mappings, flow collections
# (single- or multi-line), quoted scalars, block scalars (>/|).
# --------------------------------------------------------------------------

class FMError(ValueError):
    pass


def _unquote(s: str) -> str:
    if len(s) >= 2 and s[0] == "'" and s[-1] == "'":
        # Lenient: several files write \' inside single-quoted strings
        # (invalid YAML, but the intent is unambiguous).
        return s[1:-1].replace("''", "'").replace("\\'", "'")
    if len(s) >= 2 and s[0] == '"' and s[-1] == '"':
        inner = s[1:-1]
        out = []
        i = 0
        while i < len(inner):
            c = inner[i]
            if c == "\\" and i + 1 < len(inner):
                n = inner[i + 1]
                out.append({"n": "\n", "t": "\t", "r": "\r",
                            "\\": "\\", '"': '"', "0": "\0"}.get(n, n))
                i += 2
            else:
                out.append(c)
                i += 1
        return "".join(out)
    return s


def _flow_balanced(s: str) -> bool:
    depth, quote = 0, None
    i = 0
    while i < len(s):
        c = s[i]
        if quote:
            if c == "\\" and quote == '"':
                i += 2
                continue
            if c == quote:
                if quote == "'" and i + 1 < len(s) and s[i + 1] == "'":
                    i += 2
                    continue
                quote = None
        elif c in "'\"":
            quote = c
        elif c in "[{":
            depth += 1
        elif c in "]}":
            depth -= 1
        i += 1
    return quote is None and depth == 0


def _split_flow(s: str) -> list[str]:
    parts, depth, cur, quote = [], 0, [], None
    i = 0
    while i < len(s):
        c = s[i]
        if quote:
            cur.append(c)
            if c == "\\" and quote == '"' and i + 1 < len(s):
                cur.append(s[i + 1])
                i += 2
                continue
            if c == quote:
                if quote == "'" and i + 1 < len(s) and s[i + 1] == "'":
                    cur.append("'")
                    i += 2
                    continue
                quote = None
            i += 1
            continue
        if c in "'\"":
            quote = c
            cur.append(c)
        elif c in "[{":
            depth += 1
            cur.append(c)
        elif c in "]}":
            depth -= 1
            cur.append(c)
        elif c == "," and depth == 0:
            parts.append("".join(cur))
            cur = []
        else:
            cur.append(c)
        i += 1
    parts.append("".join(cur))
    return parts


_KEY_RE = re.compile(r"""^(?:"((?:[^"\\]|\\.)*)"|'((?:[^']|'')*)'|([A-Za-z0-9_][\w.\-]*))\s*:(?:\s+(.*))?$""")


class _Parser:
    def __init__(self, text: str):
        self.lines: list[tuple[int, str]] = []
        for raw in text.split("\n"):
            s = raw.rstrip()
            if not s.strip() or s.strip().startswith("#"):
                continue
            indent = len(s) - len(s.lstrip(" "))
            self.lines.append((indent, s.strip()))
        self.i = 0

    def parse(self):
        if not self.lines:
            return {}
        v = self._block(self.lines[0][0])
        return v if isinstance(v, dict) else {}

    def _block(self, indent: int):
        ind, content = self.lines[self.i]
        assert ind == indent, (ind, indent, content)
        if content == "-" or content.startswith("- "):
            return self._seq(indent)
        return self._map(indent)

    def _map(self, indent: int) -> dict:
        d: dict = {}
        while self.i < len(self.lines):
            ind, content = self.lines[self.i]
            if ind < indent:
                break
            if ind > indent:
                raise FMError(f"unexpected indent: {content!r}")
            m = _KEY_RE.match(content)
            if not m:
                raise FMError(f"bad mapping line: {content!r}")
            key = m.group(1) if m.group(1) is not None else (
                m.group(2).replace("''", "'") if m.group(2) is not None else m.group(3))
            rest = (m.group(4) or "").strip()
            self.i += 1
            d[key] = self._value(rest, indent)
        return d

    def _seq(self, indent: int) -> list:
        items: list = []
        while self.i < len(self.lines):
            ind, content = self.lines[self.i]
            if ind != indent or not (content == "-" or content.startswith("- ")):
                break
            self.i += 1
            rest = content[1:].strip()
            if rest == "":
                nxt = self.lines[self.i] if self.i < len(self.lines) else None
                items.append(self._block(nxt[0]) if nxt and nxt[0] > indent else None)
                continue
            m = _KEY_RE.match(rest)
            if m:
                d: dict = {}
                while True:
                    key = m.group(1) if m.group(1) is not None else (
                        m.group(2).replace("''", "'") if m.group(2) is not None else m.group(3))
                    r2 = (m.group(4) or "").strip()
                    d[key] = self._value(r2, indent)
                    nxt = self.lines[self.i] if self.i < len(self.lines) else None
                    if nxt and nxt[0] > indent:
                        ind2, c2 = nxt
                        m2 = _KEY_RE.match(c2)
                        if not m2:
                            raise FMError(f"bad mapping line: {c2!r}")
                        self.i += 1
                        m = m2
                        continue
                    break
                items.append(d)
            else:
                items.append(self._flow_or_scalar(rest))
        return items

    def _flow_or_scalar(self, rest: str):
        if rest[:1] in "[{" and not _flow_balanced(rest):
            buf = [rest]
            while self.i < len(self.lines) and not _flow_balanced(" ".join(buf)):
                buf.append(self.lines[self.i][1])
                self.i += 1
            return self._scalar(" ".join(buf))
        return self._scalar(rest)

    def _value(self, rest: str, indent: int):
        if rest != "":
            if rest in (">", "|", ">-", "|-", ">+", "|+"):
                folded = rest.startswith(">")
                chunks = []
                while self.i < len(self.lines) and self.lines[self.i][0] > indent:
                    chunks.append(self.lines[self.i][1])
                    self.i += 1
                return " ".join(chunks) if folded else "\n".join(chunks)
            return self._flow_or_scalar(rest)
        nxt = self.lines[self.i] if self.i < len(self.lines) else None
        if nxt and nxt[0] > indent:
            return self._block(nxt[0])
        return None

    def _scalar(self, s: str):
        s = s.strip()
        if s.startswith("[") and s.endswith("]"):
            return [self._scalar(p) for p in _split_flow(s[1:-1]) if p.strip() != ""]
        if s.startswith("{") and s.endswith("}"):
            d: dict = {}
            for p in _split_flow(s[1:-1]):
                if p.strip() == "":
                    continue
                m = _KEY_RE.match(p.strip())
                if not m:
                    raise FMError(f"bad flow mapping entry: {p!r}")
                key = m.group(1) if m.group(1) is not None else (
                    m.group(2).replace("''", "'") if m.group(2) is not None else m.group(3))
                d[key] = self._scalar(m.group(4) or "")
            return d
        if len(s) >= 2 and s[0] in "\"'" and s[-1] == s[0]:
            return _unquote(s)
        if s in ("~", "null", "Null", "NULL"):
            return None
        return s


def parse_frontmatter(text: str) -> dict:
    return _Parser(text).parse()


# --------------------------------------------------------------------------
# Markdown subset (mirrors bin/wb-build): headings, emphasis, code, lists,
# quotes, links, tables. Plus in-page anchors on h2/h3 for the TOC.
# --------------------------------------------------------------------------

def inline(text: str) -> str:
    out = html.escape(text, quote=False)
    out = re.sub(r"`([^`]+)`", lambda m: f"<code>{m.group(1)}</code>", out)
    out = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", out)
    out = re.sub(r"(?<![*\w])\*([^\n]+)\*(?!\w)", r"<em>\1</em>", out)
    out = re.sub(r"!\[([^\]]*)\]\(([^)]+)\)",
                 lambda m: f'<img src="{html.escape(m.group(2), quote=True)}" '
                           f'alt="{html.escape(m.group(1), quote=True)}" loading="lazy">', out)
    out = re.sub(r"\[([^\]]+)\]\(([^)]+)\)",
                 lambda m: f'<a href="{html.escape(m.group(2), quote=True)}">{m.group(1)}</a>', out)
    return out


def anchor(text: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return slug or "section"


def markdown(text: str) -> str:
    lines = text.split("\n")
    html_parts: list[str] = []
    para: list[str] = []
    list_stack: str | None = None
    in_code = False
    code: list[str] = []

    def flush_para() -> None:
        nonlocal para, in_lede
        if para:
            html_parts.append(f"<p>{inline(' '.join(para))}</p>")
            para = []
            in_lede = False

    def flush_list() -> None:
        nonlocal list_stack, in_lede
        if list_stack:
            html_parts.append(f"</{list_stack}>")
            list_stack = None
            in_lede = False

    in_lede = True  # leading blockquotes (epigraph) render small until first para/list

    for raw in lines:
        if raw.startswith("```"):
            if in_code:
                body = html.escape("\n".join(code), quote=False)
                html_parts.append(f"<pre><code>{body}</code></pre>")
                code, in_code = [], False
            else:
                flush_para(); flush_list()
                in_code = True
            continue
        if in_code:
            code.append(raw)
            continue

        line = raw.rstrip()
        if not line.strip():
            flush_para(); flush_list()
            continue

        heading = re.match(r"^(#{1,6})\s+(.*)$", line)
        if heading:
            flush_para(); flush_list()
            level = len(heading.group(1)) + 1  # page <h1> is the article title
            if level in (2, 3, 4):
                aid = anchor(heading.group(2))
                html_parts.append(f'<h{level} id="{aid}">{inline(heading.group(2))}</h{level}>')
            else:
                html_parts.append(f"<h{level}>{inline(heading.group(2))}</h{level}>")
            continue

        if line.startswith("> "):
            flush_para(); flush_list()
            cls = ' class="lede"' if in_lede else ""
            html_parts.append(f"<blockquote{cls}>{inline(line[2:])}</blockquote>")
            continue

        bullet = re.match(r"^\s*[-*]\s+(.*)$", line)
        number = re.match(r"^\s*\d+\.\s+(.*)$", line)
        if bullet or number:
            want = "ul" if bullet else "ol"
            flush_para()
            if list_stack != want:
                flush_list()
                html_parts.append(f"<{want}>")
                list_stack = want
            html_parts.append(f"<li>{inline((bullet or number).group(1))}</li>")
            continue

        if line.startswith("|"):
            flush_para(); flush_list()
            cells = [c.strip() for c in line.strip("|").split("|")]
            if all(re.fullmatch(r":?-{2,}:?", c) for c in cells):
                continue
            tag = "th" if not html_parts or not html_parts[-1].startswith("<tr") else "td"
            row = "".join(f"<{tag}>{inline(c)}</{tag}>" for c in cells)
            html_parts.append(f"<tr>{row}</tr>")
            continue

        para.append(line.strip())

    flush_para(); flush_list()
    if in_code and code:
        html_parts.append(f"<pre><code>{html.escape(chr(10).join(code))}</code></pre>")

    joined = "\n".join(html_parts)
    return re.sub(r"((?:<tr>.*?</tr>\s*)+)", r"<table>\1</table>", joined, flags=re.S)


# --------------------------------------------------------------------------
# Wikilinks: [[wiki/path|label]], [[wiki/path#frag|label]], [[#frag]],
# [[raw/...]] (repo path, not a wiki page — rendered as code).
# --------------------------------------------------------------------------

WIKILINK_RE = re.compile(r"\[\[([^\]]+)\]\]")
MDLINK_RE = re.compile(r"(?<!!)\[([^\]]+)\]\(([^)\s]+)\)")

DOMAINS = ["people", "timeline", "places", "work", "mind",
           "legal", "health", "interests", "self", "meta"]


def prettify(stem: str) -> str:
    return stem.replace("-", " ").replace("_", " ").strip().title() or stem


def norm_key(target: str) -> str:
    """Normalize a wikilink target to a page key like 'wiki/people/aaron'."""
    t = target.strip().strip("/")
    if t.endswith(".md"):
        t = t[:-3]
    if not t or t == "wiki":
        return "wiki/"
    return t if t.startswith("wiki/") else "wiki/" + t


class WikiLinker:
    def __init__(self):
        self.dead: list[tuple[str, str]] = []   # (from_page, target)
        self.raw_refs: list[tuple[str, str]] = []

    def resolve(self, body: str, page_key: str, pages: dict) -> str:
        """Replace [[...]] and [label](wiki/...) with placeholder tokens;
        markdown runs after."""
        self._tokens: list[str] = []

        def sub_md(m: re.Match) -> str:
            label, target = m.group(1), m.group(2)
            if target.startswith(("wiki/", "/wiki/")):
                # Media files are never wiki pages — leave them for the
                # markdown image/link renderer and the media_url normalizer.
                if _MEDIA_PREFIX_RE.match(target.lstrip("/")):
                    return m.group(0)
                self._tokens.append(f"{target}|{label}")
                return f"\x00WL{len(self._tokens) - 1}\x00"
            return m.group(0)

        body = MDLINK_RE.sub(sub_md, body)

        def sub(m: re.Match) -> str:
            inner = m.group(1).strip()
            self._tokens.append(inner)
            return f"\x00WL{len(self._tokens) - 1}\x00"

        return WIKILINK_RE.sub(sub, body)

    def render_tokens(self, html_text: str, page_key: str,
                      pages: dict, page_dir: str) -> str:
        def sub(m: re.Match) -> str:
            inner = self._tokens[int(m.group(1))]
            return self._link(inner, page_key, pages, page_dir)
        return re.sub(r"\x00WL(\d+)\x00", sub, html_text)

    def _link(self, inner: str, page_key: str, pages: dict, page_dir: str) -> str:
        # Split target|label on the first pipe. \| is the separator escaped
        # for table contexts; a \| inside the label stays a literal pipe.
        tmp = inner.replace("\\|", "\x00PIPE\x00")
        segs = tmp.split("|", 1)
        if len(segs) == 2:
            target = segs[0].replace("\x00PIPE\x00", "|").strip()
            label = segs[1].replace("\x00PIPE\x00", "|").strip()
        else:
            segs = tmp.split("\x00PIPE\x00", 1)
            if len(segs) == 2:
                target, label = segs[0].strip(), segs[1].strip()
            else:
                target, label = tmp.replace("\x00PIPE\x00", "|").strip(), None

        # In-page anchor: [[#frag]] / [[#frag|label]]
        if target.startswith("#"):
            frag = anchor(target[1:])
            return f'<a href="#{frag}">{html.escape(label or target[1:])}</a>'

        # Raw-repo reference, or a bare repo file like [[CLAUDE.md]]:
        # not a wiki page — render as code.
        if target.startswith("raw/") or not target.startswith("wiki/"):
            self.raw_refs.append((page_key, target))
            return f"<code>{html.escape(label or target)}</code>"

        frag = ""
        if "#" in target:
            target, _, frag = target.partition("#")
            frag = anchor(frag)
        key = norm_key(target)
        page = pages.get(key)
        if page is None:
            self.dead.append((page_key, inner))
            text = html.escape(label or target)
            return (f'<span class="deadlink" title="No such article: '
                    f'{html.escape(key)}">{text}</span>')
        href = os.path.relpath(page["url"], page_dir or ".")
        if frag:
            href += f"#{frag}"
        text = html.escape(label or page["title"])
        return f'<a href="{html.escape(href, quote=True)}">{text}</a>'


