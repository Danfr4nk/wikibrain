.wblib{display:flex;flex-wrap:wrap;gap:16px;margin:14px 0}
.wblib figure.wbmedia{width:200px;margin:0}
.wblib figure.wbmedia img{width:100%;height:auto;margin:0}
.wblib figure.wbmedia figcaption{font-size:12.5px}
</style>"""

